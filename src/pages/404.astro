---
import { home } from '../lib/paths';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Albert Technical Consulting">
  <section class="mx-auto max-w-6xl px-4 py-28 sm:px-6 sm:py-40">
    <p class="label text-accent">Page not found</p>
    <h1 class="mt-6 max-w-2xl font-serif text-5xl leading-[1.05] tracking-[-0.02em] sm:text-6xl">
      That page <em class="text-accent">isn’t here.</em>
    </h1>
    <a
      href={home}
      class="mt-10 inline-flex items-center gap-3 rounded-sm bg-accent px-6 py-3.5 font-semibold text-paper hover:bg-accent-dark"
    >
      <span aria-hidden="true">←</span> Back to the home page
    </a>
  </section>
</Base>

---
import SectionHead from './SectionHead.astro';
import type { Page } from '../data/site';

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

<section id="faq" class="border-t border-rule bg-paper-2">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <SectionHead label="FAQ" title="Common questions." />

    <div class="md:grid md:grid-cols-12 md:gap-x-8">
      <div class="border-t border-ink md:col-span-9 md:col-start-4">
        {
          page.faqs.map((f) => (
            <details class="group border-b border-rule">
              <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-5">
                <span class="font-serif text-[1.3rem] leading-snug group-hover:text-accent">{f.q}</span>
                <span class="text-xl text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="max-w-[38rem] pb-6 leading-relaxed text-ink/80">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

---
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import { about, hero, site } from '../data/site';

const [h1, h2, h3] = hero.headline;
---

<section class="bg-night text-cream">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-12 pb-16 sm:px-6 sm:pt-16 lg:grid-cols-12 lg:gap-x-8 lg:pb-20">
    <div class="lg:col-span-7 lg:pt-4">
      <p class="label text-accent-light">{hero.kicker}</p>
      <h1
        class="mt-6 font-serif text-[2.9rem] leading-[1.0] font-medium tracking-[-0.03em] text-balance sm:text-[4rem] lg:text-[4.35rem]"
      >
        {h1} <em class="font-normal text-accent-light">{h2}</em>{' '}{h3}
      </h1>
      <p class="mt-7 max-w-[32rem] text-[1.15rem] leading-relaxed text-cream/80">{hero.lede}</p>

      <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
        <CtaButton location="hero" tone="light" />
        <a
          href={`mailto:${site.contact.email}`}
          data-track="email_click"
          data-location="hero"
          class="text-cream/80 underline decoration-cream/30 underline-offset-4 hover:text-cream hover:decoration-cream"
        >
          or email {site.firstName}
        </a>
      </div>
      <p class="mt-4 text-sm text-cream/55">{hero.reassurance}</p>
    </div>

    <aside class="flex gap-5 sm:gap-7 lg:col-span-4 lg:col-start-9 lg:block" aria-label={`About ${site.firstName}`}>
      {
        about.photo && (
          <Image
            src={about.photo}
            alt={`Portrait of ${site.principal}`}
            widths={[160, 320, 480, 720, 960]}
            sizes="(min-width: 1024px) 360px, 128px"
            loading="eager"
            fetchpriority="high"
            class="h-32 w-32 shrink-0 rounded-sm object-cover sm:h-40 sm:w-40 lg:mb-6 lg:aspect-square lg:h-auto lg:w-full"
          />
        )
      }
      <div>
        <p class="font-serif text-[1.45rem] leading-tight">{site.principal}</p>
        <ul class="mt-3 space-y-2 text-[0.95rem] leading-snug text-cream/75">
          {hero.trust.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</section>

---
import { home } from '../lib/paths';
import { businessPage, nonprofitPage, site } from '../data/site';

const year = new Date().getFullYear();
const pages = [nonprofitPage, businessPage];
---

<footer class="bg-night pb-20 text-cream/70 sm:pb-0">
  <div class="mx-auto max-w-6xl px-4 text-sm sm:px-6">
    <div class="grid gap-8 border-t border-cream/15 py-12 sm:grid-cols-4">
      <div class="sm:col-span-2">
        <p class="font-serif text-xl font-medium text-cream">
          Albert <span class="text-accent-light italic">Technical</span> Consulting
        </p>
        <p class="mt-2 max-w-xs leading-relaxed">
          Technology help for nonprofits, and automation and AI for businesses, in {site.location.county}, {site.location.state}.
        </p>
        <p class="mt-3 max-w-xs leading-relaxed">Serving {site.location.towns.join(', ')}, and nearby communities.</p>
      </div>
      {
        pages.map((p) => (
          <div>
            <p class="label text-cream/75">
              <a href={`${home}${p.path}`} class="hover:text-cream">
                For {p.audience.toLowerCase()}
              </a>
            </p>
            <ul class="mt-3 space-y-1">
              {p.services.map((s) => (
                <li>
                  <a href={`${home}${p.path}#services`} class="hover:text-cream">
                    {s.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="flex flex-wrap justify-between gap-4 border-t border-cream/10 py-6 text-cream/70">
      <span>© {year} {site.business} · {site.principal}</span>
      <a href={`mailto:${site.contact.email}`} data-track="email_click" data-location="footer" class="hover:text-cream">
        {site.contact.email}
      </a>
    </p>
  </div>
</footer>

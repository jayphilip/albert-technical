---
// Fixed bar on small screens so booking is always one tap away.
import { call } from '../data/site';
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-cream/15 bg-night p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] sm:hidden">
  <a
    href="#book"
    data-track="book_click"
    data-location="mobile_bar"
    class="block rounded-sm bg-cta py-3 text-center font-semibold text-on-cta"
  >
    {call.cta}
  </a>
</div>

---
interface Props {
  label: string;
  title: string;
  tone?: 'light' | 'dark';
}

const { label, title, tone = 'light' } = Astro.props;
---

<div class="mb-10 grid gap-x-8 gap-y-3 sm:mb-12 md:grid-cols-12">
  <p class:list={['label md:col-span-3 md:pt-3', tone === 'dark' ? 'text-accent-light' : 'text-accent']}>{label}</p>
  <h2 class="font-serif text-[2.1rem] leading-[1.1] font-normal tracking-[-0.015em] text-balance sm:text-[2.6rem] md:col-span-9">
    <Fragment set:html={title} />
  </h2>
</div>

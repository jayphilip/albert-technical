---
import type { Page } from '../data/site';

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

<section aria-label="Track record" class="border-b border-rule">
  <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-x-8 gap-y-8 px-4 py-10 sm:px-6 lg:grid-cols-4">
    {
      page.figures.map((f) => (
        <div class="flex flex-col-reverse">
          <dt class="mt-2 text-sm leading-snug text-muted">{f.label}</dt>
          <dd class="font-serif text-[1.9rem] leading-none tracking-[-0.02em] whitespace-nowrap text-ink sm:text-[2.8rem]">{f.figure}</dd>
        </div>
      ))
    }
  </dl>
</section>
